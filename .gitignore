.DS_Store

# Personal Codex configuration; the example beside it is synced from warden and committed.
.codex/*
!.codex/config.toml.example
.reference
.zed/

.dev.vars
.env*
.wrangler/
.wrangler-harness-*.json

bin/
/coverage/
node_modules/
tmp/

# Generated assets module — a consumer-side build artifact, never committed.
.forge/

# Playwright run artifacts — `bun run release` refuses a dirty tree, so these must never be tracked.
playwright-report/
test-results/

*.test
*.out

# Personal Claude Code approvals and choices — team policy is .claude/settings.json.
.claude/settings.local.json
