{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(bun test *)",
      "Bash(echo \"FIX:$?\")"
    ],
    "deny": [
      "Bash(git add *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git cherry-pick *)",
      "Bash(git clean *)",
      "Bash(git clone *)",
      "Bash(git commit *)",
      "Bash(git commit-tree *)",
      "Bash(git config *)",
      "Bash(git fast-import *)",
      "Bash(git filter-branch *)",
      "Bash(git gc *)",
      "Bash(git hash-object *)",
      "Bash(git init *)",
      "Bash(git maintenance *)",
      "Bash(git merge *)",
      "Bash(git mv *)",
      "Bash(git notes *)",
      "Bash(git prune *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git remote *)",
      "Bash(git repack *)",
      "Bash(git replace *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git revert *)",
      "Bash(git rm *)",
      "Bash(git stash *)",
      "Bash(git submodule *)",
      "Bash(git switch *)",
      "Bash(git symbolic-ref *)",
      "Bash(git tag *)",
      "Bash(git update-index *)",
      "Bash(git update-ref *)",
      "Bash(git worktree *)",
      "Bash(git write-tree *)",
      "Bash(git -*)"
    ]
  },
  "model": "opus[1m]",
  "enabledMcpjsonServers": [
    "ledger",
    "warden"
  ],
  "effortLevel": "medium",
  "showClearContextOnPlanAccept": true,
  "autoMemoryEnabled": false
}
