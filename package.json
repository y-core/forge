{
  "name": "@y-core/forge",
  "version": "0.3.1",
  "bin": {
    "forge": "./src/tooling/root/bin.ts",
    "warden": "./warden/src/bin.ts"
  },
  "type": "module",
  "packageManager": "bun@1.4.0",
  "description": "A Web standards platform for server-rendered web applications, built on a foundation of Web APIs for seamless deployment on Cloudflare Workers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y-core/forge.git"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "warden": {
    "kind": "libs"
  },
  "forge": {
    "devOnly": [
      "./dev",
      "./testing",
      "./testing/coverage",
      "./testing/node",
      "./testing/snapshot",
      "./testing/workerd",
      "./tooling/*"
    ]
  },
  "scripts": {
    "fix": "bun run src/tooling/root/bin.ts verify --fix",
    "gen:bundles": "bun run src/tooling/gate/checks/bundle.ts",
    "gen:icc": "bun run src/tooling/gate/checks/icc-profile.ts && oxfmt src/output/pdf/icc.ts",
    "gen:class-groups": "bun run src/tooling/gate/checks/class-groups.ts && oxfmt src/ui/core/utils/class-groups.ts",
    "gen:design-scale": "bun run src/tooling/gate/checks/design-scale.ts && oxfmt src/tooling/lint/data/design-scale.ts",
    "lint": "bun run src/tooling/root/bin.ts verify --only lint",
    "release": "bun run src/tooling/root/bin.ts release",
    "release:gate": "bun run verify:full && bun run src/tooling/dev/coverage.ts ../starter tests/unit/showcase/coverage.fixture.test.tsx",
    "test": "bun test",
    "test:browser": "playwright test",
    "test:workerd": "bun test --parallel=2 tests/workerd/",
    "verify": "bun run src/tooling/root/bin.ts verify",
    "verify:full": "bun run src/tooling/root/bin.ts verify --full",
    "verify:quality": "bun run src/tooling/root/bin.ts verify --mode quality",
    "prepublishOnly": "bun run verify:full"
  },
  "sideEffects": [
    "./src/auth/client/mod.ts",
    "./src/jsx/register.ts",
    "./src/ui/chrome/client.ts",
    "./src/ui/client/htmx.ts",
    "./src/ui/core/client.ts"
  ],
  "dependencies": {
    "@remix-run/fetch-router": "^0.22.0",
    "@remix-run/headers": "^0.21.1",
    "@remix-run/route-pattern": "^0.24.0",
    "@remix-run/session": "^0.4.2",
    "htmx.org": "^2.0.10",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@expo-google-fonts/oswald": "^0.4.2",
    "@playwright/test": "^1.63.0",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "esbuild": "^0.28.2",
    "harfbuzzjs": "^1.6.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.0"
  },
  "peerDependencies": {
    "esbuild": ">=0.20.0",
    "harfbuzzjs": ">=1.6.0",
    "sharp": ">=0.33.0",
    "tailwindcss": ">=4.0.0",
    "wrangler": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "harfbuzzjs": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    }
  },
