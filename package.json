{
  "name": "@y-core/forge",
  "version": "0.1.0",
  "bin": {
    "forge": "./src/cli/root/bin.ts"
  },
  "type": "module",
  "description": "Server-rendered web utilities and an integrated command layer for Cloudflare Workers — HTMX + Tailwind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y-core/forge.git"
  },
  "license": "MIT",
  "governance": {
    "kind": "libs"
  },
  "scripts": {
    "fix": "bun run src/cli/root/bin.ts verify --fix",
    "gen:class-groups": "bun run src/cli/pkg/gate/checks/class-groups.ts && oxfmt src/ui/core/utils/class-groups.ts",
    "gen:design-scale": "bun run src/cli/pkg/gate/checks/design-scale.ts && oxfmt src/cli/pkg/lint/data/design-scale.ts",
    "lint": "bun run src/cli/root/bin.ts verify --only lint",
    "release": "bun run src/cli/root/bin.ts release",
    "test": "bun test",
    "test:browser": "playwright test",
    "verify": "bun run src/cli/root/bin.ts verify",
    "verify:full": "bun run src/cli/root/bin.ts verify --full",
    "prepublishOnly": "bun run verify:full"
  },
  "sideEffects": [
    "./src/jsx/register.ts",
    "./src/ui/chrome/client.ts",
    "./src/ui/client/htmx.ts",
    "./src/ui/core/client.ts",
    "./src/ui/show/client.ts"
  ],
  "dependencies": {
    "@remix-run/cookie": "^0.5.4",
    "@remix-run/fetch-router": "^0.20.1",
    "@remix-run/headers": "^0.21.1",
    "@remix-run/html-template": "^0.3.1",
    "@remix-run/response": "^0.3.7",
    "@remix-run/route-pattern": "^0.23.0",
    "@remix-run/session": "^0.4.2",
    "htmx.org": "^2.0.10",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@y-core/governance": "https://codeload.github.com/y-core/governance/tar.gz/refs/tags/v0.4.4",
    "esbuild": "^0.28.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "esbuild": ">=0.20.0",
    "sharp": "latest",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
