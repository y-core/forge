{
  "name": "d1-backup-fixture",
  "main": "worker.ts",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "backup-fixture", "database_id": "backup-fixture-local" },
    { "binding": "STANDBY", "database_name": "backup-fixture-standby", "database_id": "backup-fixture-standby" },
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "backup-fixture" }],
}
