diff --git a/src/ui/core/description-list.test.tsx b/src/ui/core/description-list.test.tsx
new file mode 100644
index 00000000..64d36bd4
--- /dev/null
+++ b/src/ui/core/description-list.test.tsx
@@ -0,0 +1,68 @@
+/** @jsxRuntime automatic */
+/** @jsxImportSource @y-core/forge/render/jsx */
+import { describe, expect, it } from "bun:test";
+
+import { attrOf, attrsOf, classesOf, tagOf, variantClasses } from "../../testing/markup";
+import { render } from "../../testing/render";
+import { DescriptionList } from "./description-list";
+
+describe("DescriptionList", () => {
+  it("renders the whole list exactly, its own slot token ahead of an inherited one and a forwarded value escaped", async () => {
+    expect(await render(<DescriptionList data-slot='facts' data-note={`R&D's "n" <x>`} />)).toBe(
+      '<dl data-slot="description-list facts" class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm"' +
+        ' data-note="R&amp;D&#39;s &quot;n&quot; &lt;x&gt;"></dl>',
+    );
+  });
+
+  it("lets a caller gap evict its own rather than sitting behind it", async () => {
+    expect(variantClasses(await render(<DescriptionList class='gap-y-4' />), await render(<DescriptionList />))).toEqual({
+      added: ["gap-y-4"],
+      dropped: ["gap-y-2"],
+    });
+  });
+});
+
+describe("DescriptionList.Term", () => {
+  it("renders a plain term with no link inside it", async () => {
+    const html = await render(<DescriptionList.Term>Owner</DescriptionList.Term>);
+
+    expect(attrsOf(html)).toEqual({ "data-slot": "description-list-term" });
+    expect(tagOf(html, 'data-slot="description-list-link"')).toBe("");
+  });
+
+  it("wraps the term's text in a link when given an href, leaving the term itself a dt", async () => {
+    const html = await render(<DescriptionList.Term href='/people/ada'>Owner</DescriptionList.Term>);
+
+    expect(tagOf(html).startsWith("<dt ")).toBe(true);
+    expect(attrOf(html, "href", 'data-slot="description-list-link"')).toBe("/people/ada");
+    expect(html.split(/<[^>]+>/).filter(Boolean)).toEqual(["Owner"]);
+  });
+
+  it("paints the forge focus ring on the link, so keyboard focus shows", async () => {
+    const html = await render(<DescriptionList.Term href='/a'>A</DescriptionList.Term>);
+
+    expect(classesOf(html, 'data-slot="description-list-link"')).toEqual([
+      "focus-ring",
+      "rounded-sm",
+      "underline",
+      "underline-offset-4",
+      "hover:text-primary",
+    ]);
+  });
+
+  it("collapses a script-scheme href to a fragment, as the renderer does for every URL attribute", async () => {
+    const html = await render(<DescriptionList.Term href='javascript:alert(1)'>A</DescriptionList.Term>);
+
+    expect(attrOf(html, "href", 'data-slot="description-list-link"')).toBe("#");
+  });
+});
+
+describe("DescriptionList.Details", () => {
+  it("renders a dd under its slot, muted against the term", async () => {
+    const html = await render(<DescriptionList.Details>Ada</DescriptionList.Details>);
+
+    expect(tagOf(html).startsWith("<dd ")).toBe(true);
+    expect(attrsOf(html)).toEqual({ "data-slot": "description-list-details" });
+    expect(classesOf(html)).toEqual(["text-muted-foreground"]);
+  });
+});
diff --git a/src/ui/core/description-list.tsx b/src/ui/core/description-list.tsx
new file mode 100644
index 00000000..a8dd5f36
--- /dev/null
+++ b/src/ui/core/description-list.tsx
@@ -0,0 +1,43 @@
+/** @jsxRuntime automatic */
+/** @jsxImportSource @y-core/forge/render/jsx */
+import type { FC, JSX, JSXNode } from "../../render/jsx/types";
+import { slotToken } from "./utils/as-child";
+import { cn } from "./utils/cn";
+
+type DescriptionListProps = JSX.IntrinsicElements["dl"];
+
+interface DescriptionListTermProps extends Omit<JSX.IntrinsicElements["dt"], "children"> {
+  href?: string | undefined;
+  children?: JSXNode | undefined;
+}
+
+type DescriptionListDetailsProps = JSX.IntrinsicElements["dd"];
+
+const TERM_LINK = "focus-ring rounded-sm underline underline-offset-4 hover:text-primary";
+
+const DescriptionListRoot: FC<DescriptionListProps> = ({ class: cls, children, "data-slot": inherited, ...rest }) => (
+  <dl data-slot={slotToken("description-list", inherited)} class={cn("grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm", cls)} {...rest}>
+    {children}
+  </dl>
+);
+
+const DescriptionListTerm: FC<DescriptionListTermProps> = ({ href, class: cls, children, "data-slot": inherited, ...rest }) => (
+  <dt data-slot={slotToken("description-list-term", inherited)} class={cn("font-medium text-foreground", cls)} {...rest}>
+    {href === undefined ? (
+      children
+    ) : (
+      <a data-slot='description-list-link' href={href} class={TERM_LINK}>
+        {children}
+      </a>
+    )}
+  </dt>
+);
+
+const DescriptionListDetails: FC<DescriptionListDetailsProps> = ({ class: cls, children, "data-slot": inherited, ...rest }) => (
+  <dd data-slot={slotToken("description-list-details", inherited)} class={cn("text-muted-foreground", cls)} {...rest}>
+    {children}
+  </dd>
+);
+
+/** Term and description pairs as a `<dl>`, with `Term` — a link when given `href` — and `Details` subcomponents. @public */
+export const DescriptionList = Object.assign(DescriptionListRoot, { Term: DescriptionListTerm, Details: DescriptionListDetails });
