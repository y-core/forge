diff --git a/tests/webhooks.test.ts b/tests/webhooks.test.ts
new file mode 100644
index 00000000..5687cdf9
--- /dev/null
+++ b/tests/webhooks.test.ts
@@ -0,0 +1,92 @@
+import { afterEach, beforeEach, describe, expect, it, mock, spyOn } from "bun:test";
+
+import { createWebhookSigning } from "@y-core/forge/security";
+import { openBunD1 } from "@y-core/forge/testing/d1/bun";
+import type { TestD1 } from "@y-core/forge/testing/d1/bun";
+
+import { createWorker } from "../src/worker";
+import { TEST_WEBHOOK_SECRET, testEnv } from "./env";
+
+let d1: TestD1;
+let forwarded: { url: string; body: string }[];
+let fulfilmentStatus: number;
+
+beforeEach(async () => {
+  d1 = await openBunD1();
+  forwarded = [];
+  fulfilmentStatus = 202;
+  spyOn(globalThis, "fetch").mockImplementation((async (input: string | URL | Request, init?: RequestInit) => {
+    forwarded.push({ url: String(input), body: String(init?.body) });
+    return new Response(null, { status: fulfilmentStatus });
+  }) as typeof fetch);
+});
+
+afterEach(async () => {
+  mock.restore();
+  await d1.dispose();
+});
+
+const sender = createWebhookSigning({ secrets: [TEST_WEBHOOK_SECRET] });
+
+async function deliver(payload: unknown, headers?: Record<string, string>): Promise<Response> {
+  const body = JSON.stringify(payload);
+  const signed = headers ?? (await sender.sign({ id: "msg_1", body }));
+  return createWorker({ scriptSrc: ["'self'"] }).request(
+    "/webhooks/orders",
+    { method: "POST", body, headers: { ...signed, "content-type": "application/json" } },
+    testEnv(d1),
+  );
+}
+
+describe("the order webhook", () => {
+  it("forwards a signed order to fulfilment and answers 204", async () => {
+    const res = await deliver({ orderId: "o-1", totalCents: 1250 });
+
+    expect(res.status).toBe(204);
+    expect(forwarded).toEqual([{ url: "https://fulfil.example/orders", body: '{"orderId":"o-1","totalCents":1250}' }]);
+  });
+
+  it("refuses a delivery whose signature does not verify, forwarding nothing", async () => {
+    const forged = { "webhook-id": "msg_1", "webhook-timestamp": String(Math.floor(Date.now() / 1000)), "webhook-signature": "v1,AAAA" };
+
+    expect((await deliver({ orderId: "o-1", totalCents: 1250 }, forged)).status).toBe(401);
+    expect(forwarded).toEqual([]);
+  });
+
+  it("refuses a signed body that is not an order, forwarding nothing", async () => {
+    expect((await deliver({ orderId: "o-1", totalCents: -5 })).status).toBe(422);
+    expect(forwarded).toEqual([]);
+  });
+
+  it("answers 502 when fulfilment refuses the order", async () => {
+    fulfilmentStatus = 503;
+
+    expect((await deliver({ orderId: "o-1", totalCents: 1250 })).status).toBe(502);
+  });
+});
+
+describe("the status API", () => {
+  const status = (path: string, init: RequestInit) => createWorker({ scriptSrc: ["'self'"] }).request(path, init, testEnv(d1));
+
+  it("lets the partner origin read it cross-origin", async () => {
+    const res = await status("/api/status", { headers: { Origin: "https://partner.example" } });
+
+    expect([res.status, res.headers.get("access-control-allow-origin"), await res.json()]).toEqual([
+      200,
+      "https://partner.example",
+      { status: "ok" },
+    ]);
+  });
+
+  it("names no other origin", async () => {
+    const res = await status("/api/status", { headers: { Origin: "https://elsewhere.example" } });
+
+    expect(res.headers.get("access-control-allow-origin")).toBeNull();
+  });
+
+  it("opens no other route to the partner", async () => {
+    const res = await status("/", { headers: { Origin: "https://partner.example" } });
+
+    expect(res.headers.get("access-control-allow-origin")).toBeNull();
+  });
+});
