+import { getAppContext } from "@y-core/forge/context";
+import { createAction } from "@y-core/forge/router";
+import { v } from "@y-core/forge/validation";
+
+import { appConfig } from "../app/config";
+import type { Bindings } from "../app/types";
+import { OrderEventSchema } from "../model/order";
+import { routes } from "../routes";
+import { forwardOrder } from "../services/fulfilment";
+import { resolveOrderWebhooks } from "../services/webhooks";
+
+function parseJson(bytes: Uint8Array): unknown {
+  try {
+    return JSON.parse(new TextDecoder().decode(bytes));
+  } catch {
+    return undefined;
+  }
+}
+
+export const orderWebhook = createAction(routes.orderWebhook, async (context) => {
+  const c = getAppContext<Bindings>(context);
+  const config = appConfig.get(c.env);
+  const verified = await (await resolveOrderWebhooks(c)).verify(c.request);
+  if (!verified.ok) return new Response("Unauthorized", { status: 401 });
+  const order = v.safeParse(OrderEventSchema, parseJson(verified.data.body));
+  if (!order.success) return new Response("Unprocessable order", { status: 422 });
+  if (!(await forwardOrder(order.output, config.fulfilmentUrl))) return new Response("Fulfilment unavailable", { status: 502 });
+  return new Response(null, { status: 204 });
+});
