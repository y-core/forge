@@ -0,0 +1,11 @@
+import type { OrderEvent } from "../model/order";
+
+/** Hands a verified order to the fulfilment API, answering whether it accepted it. */
+export async function forwardOrder(order: OrderEvent, fulfilmentUrl: string): Promise<boolean> {
+  const res = await fetch(fulfilmentUrl, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ orderId: order.orderId, totalCents: order.totalCents }),
+  });
+  return res.ok;
+}
