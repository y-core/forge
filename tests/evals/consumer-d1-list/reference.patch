+++ b/tests/guestbook.test.ts
@@ -0,0 +1,62 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+
+import { openBunD1 } from "@y-core/forge/testing/d1/bun";
+import type { TestD1 } from "@y-core/forge/testing/d1/bun";
+
+import { createWorker } from "../src/worker";
+import { testEnv } from "./env";
+
+let d1: TestD1;
+
+beforeEach(async () => {
+  d1 = await openBunD1();
+});
+
+afterEach(async () => {
+  await d1.dispose();
+});
+
+async function seed(count: number): Promise<void> {
+  const insert = d1.binding.prepare("INSERT INTO guestbook_entries (id, name, message, created_at) VALUES (?, ?, ?, ?)");
+  await d1.binding.batch(Array.from({ length: count }, (_, i) => insert.bind(i + 1, `Guest ${i + 1}`, `Message ${i + 1}`, 1_000 + i)));
+}
+
+async function visit(path: string): Promise<{ status: number; names: string[]; next: string | undefined; prev: string | undefined }> {
+  const res = await createWorker({ scriptSrc: ["'self'"] }).request(path, {}, testEnv(d1));
+  const html = await res.text();
+  return {
+    status: res.status,
+    names: [...html.matchAll(/<strong>([^<]*)<\/strong>/g)].map((match) => match[1] ?? ""),
+    next: /<a rel="next" href="([^"]*)"/.exec(html)?.[1],
+    prev: /<a rel="prev" href="([^"]*)"/.exec(html)?.[1],
+  };
+}
+
+describe("the guestbook", () => {
+  it("lists the ten newest entries first, linking to the older ones", async () => {
+    await seed(12);
+
+    expect(await visit("/guestbook")).toEqual({
+      status: 200,
+      names: Array.from({ length: 10 }, (_, i) => `Guest ${12 - i}`),
+      next: "/guestbook?page=2",
+      prev: undefined,
+    });
+  });
+
+  it("serves the remainder on the second page, linking back and no further", async () => {
+    await seed(12);
+
+    expect(await visit("/guestbook?page=2")).toEqual({ status: 200, names: ["Guest 2", "Guest 1"], next: undefined, prev: "/guestbook?page=1" });
+  });
+
+  it("says so when there are no entries", async () => {
+    const res = await createWorker({ scriptSrc: ["'self'"] }).request("/guestbook", {}, testEnv(d1));
+
+    expect((await res.text()).split(/<[^>]+>/).filter(Boolean)).toEqual(["Guestbook — Forge Eval", "Guestbook", "No entries yet."]);
+  });
+
+  it("refuses a page that is not a positive whole number", async () => {
+    expect([(await visit("/guestbook?page=0")).status, (await visit("/guestbook?page=two")).status]).toEqual([400, 400]);
+  });
+});
