@@ -0,0 +1,18 @@
+import { renderPage } from "@y-core/forge/render/jsx";
+
+import { definePage } from "../app/handlers";
+import { GuestbookQuery } from "../model/guestbook";
+import { routes } from "../routes";
+import { guestbookPage } from "../services/guestbook";
+import { GuestbookUnavailableView, GuestbookView } from "../views/guestbook";
+
+export const guestbook = definePage(routes.guestbook, {
+  query: GuestbookQuery,
+  loader: async (c, config, query) => ({ siteName: config.siteName, listing: await guestbookPage(c.env.DB, query.page) }),
+  view: (_c, _config, state) => {
+    const { siteName, listing } = state.data;
+    if (listing === null) return renderPage(GuestbookUnavailableView({ siteName }), { status: 503 });
+    const pageHref = (page: number) => `${routes.guestbook.href()}?page=${page}`;
+    return renderPage(GuestbookView({ siteName, listing, pageHref }));
+  },
+});
