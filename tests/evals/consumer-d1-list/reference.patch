@@ -0,0 +1,26 @@
+import { createD1Client, sql } from "@y-core/forge/storage/db";
+
+import { GUESTBOOK_PAGE_SIZE } from "../model/guestbook";
+import type { GuestbookEntry, GuestbookPage } from "../model/guestbook";
+
+interface EntryRow {
+  id: number;
+  name: string;
+  message: string;
+  created_at: number;
+}
+
+/** One page of the guestbook, newest first, and whether a later page exists. */
+export async function guestbookPage(db: D1Database, page: number): Promise<GuestbookPage | null> {
+  const offset = (page - 1) * GUESTBOOK_PAGE_SIZE;
+  const rows = await createD1Client(db).query<EntryRow>(
+    sql`SELECT id, name, message, created_at FROM guestbook_entries
+        ORDER BY created_at DESC, id DESC
+        LIMIT ${GUESTBOOK_PAGE_SIZE + 1} OFFSET ${offset}`,
+  );
+  if (!rows.ok) return null;
+  const entries: GuestbookEntry[] = rows.data
+    .slice(0, GUESTBOOK_PAGE_SIZE)
+    .map((row) => ({ id: row.id, name: row.name, message: row.message, createdAt: row.created_at }));
+  return { page, entries, hasNext: rows.data.length > GUESTBOOK_PAGE_SIZE };
+}
diff --git a/src/views/guestbook.tsx b/src/views/guestbook.tsx
new file mode 100644
index 00000000..3aeac909
--- /dev/null
+++ b/src/views/guestbook.tsx
@@ -0,0 +1,64 @@
+import type { GuestbookPage } from "../model/guestbook";
+
+interface GuestbookViewProps {
+  siteName: string;
+  listing: GuestbookPage;
+  pageHref: (page: number) => string;
+}
+
+export function GuestbookView({ siteName, listing, pageHref }: GuestbookViewProps) {
+  return (
+    <html lang='en'>
+      <head>
+        <meta charset='utf-8' />
+        <title>Guestbook — {siteName}</title>
+      </head>
+      <body>
+        <main>
+          <h1>Guestbook</h1>
+          {listing.entries.length === 0 ? (
+            <p>No entries yet.</p>
+          ) : (
+            <ol>
+              {listing.entries.map((entry) => (
+                <li data-entry={String(entry.id)}>
+                  <strong>{entry.name}</strong>
+                  <p>{entry.message}</p>
+                </li>
+              ))}
+            </ol>
+          )}
+          <nav aria-label='Guestbook pages'>
+            {listing.page > 1 ? (
+              <a rel='prev' href={pageHref(listing.page - 1)}>
+                Newer entries
+              </a>
+            ) : null}
+            {listing.hasNext ? (
+              <a rel='next' href={pageHref(listing.page + 1)}>
+                Older entries
+              </a>
+            ) : null}
+          </nav>
+        </main>
+      </body>
+    </html>
+  );
+}
+
+export function GuestbookUnavailableView({ siteName }: { siteName: string }) {
+  return (
+    <html lang='en'>
+      <head>
+        <meta charset='utf-8' />
+        <title>Guestbook — {siteName}</title>
+      </head>
+      <body>
+        <main>
+          <h1>Guestbook</h1>
+          <p>The guestbook cannot be read right now. Try again in a moment.</p>
+        </main>
+      </body>
+    </html>
+  );
+}
