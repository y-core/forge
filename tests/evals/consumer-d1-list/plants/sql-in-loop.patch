 /** One page of the guestbook, newest first, and whether a later page exists. */
 export async function guestbookPage(db: D1Database, page: number): Promise<GuestbookPage | null> {
+  const client = createD1Client(db);
   const offset = (page - 1) * GUESTBOOK_PAGE_SIZE;
-  const rows = await createD1Client(db).query<EntryRow>(
-    sql`SELECT id, name, message, created_at FROM guestbook_entries
+  const ids = await client.query<{ id: number }>(
+    sql`SELECT id FROM guestbook_entries
         ORDER BY created_at DESC, id DESC
         LIMIT ${GUESTBOOK_PAGE_SIZE + 1} OFFSET ${offset}`,
   );
-  if (!rows.ok) return null;
-  const entries: GuestbookEntry[] = rows.data
