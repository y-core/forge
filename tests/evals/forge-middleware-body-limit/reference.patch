@@ -0,0 +1,91 @@
+import { describe, expect, it } from "bun:test";
+
+import type { Middleware } from "@remix-run/fetch-router";
+
+import { Forge } from "../app/forge-app";
+import { refuseHookCtx } from "../context/refusal";
+import type { Refusal } from "../context/types";
+import { mapHandler } from "../testing/route";
+import { bodyLimit } from "./body-limit";
+import type { BodyLimitOptions } from "./types";
+
+function makeApp(options: BodyLimitOptions, before: Middleware[] = []) {
+  const app = new Forge();
+  app.use("*", ...before, bodyLimit(options));
+  mapHandler(app, "POST", "/upload", async ({ request }) => new Response(`read ${(await request.arrayBuffer()).byteLength}`));
+  return app;
+}
+
+function streamOf(...chunks: string[]): ReadableStream<Uint8Array> {
+  const encoder = new TextEncoder();
+  return new ReadableStream({
+    start(controller) {
+      for (const chunk of chunks) controller.enqueue(encoder.encode(chunk));
+      controller.close();
+    },
+  });
+}
+
+function streamed(body: ReadableStream<Uint8Array>): RequestInit {
+  return { method: "POST", body, duplex: "half" } as RequestInit;
+}
+
+describe("bodyLimit", () => {
+  it("passes a body within the cap on to the handler, which can still read it whole", async () => {
+    const res = await makeApp({ maxBytes: 8 }).request("/upload", { method: "POST", body: "12345678" });
+
+    expect([res.status, await res.text()]).toEqual([200, "read 8"]);
+  });
+
+  it("refuses 413 on a declared Content-Length over the cap, before the handler runs", async () => {
+    const res = await makeApp({ maxBytes: 4 }).request("/upload", { method: "POST", body: "12345", headers: { "Content-Length": "5" } });
+
+    expect([res.status, await res.text()]).toEqual([413, "Payload Too Large"]);
+  });
+
+  it("refuses 413 on a streamed body that runs past the cap with no Content-Length", async () => {
+    const res = await makeApp({ maxBytes: 4 }).request("/upload", streamed(streamOf("123", "456")));
+
+    expect([res.status, await res.text()]).toEqual([413, "Payload Too Large"]);
+  });
+
+  it("passes a streamed body that stays within the cap", async () => {
+    const res = await makeApp({ maxBytes: 6 }).request("/upload", streamed(streamOf("123", "456")));
+
+    expect([res.status, await res.text()]).toEqual([200, "read 6"]);
+  });
+
+  it("answers through its own hook, handing it the body-limit refusal", async () => {
+    const seen: Refusal[] = [];
+    const onRefuse = (_c: unknown, refusal: Refusal) => {
+      seen.push(refusal);
+      return new Response("too big", { status: 413 });
+    };
+    const res = await makeApp({ maxBytes: 1, onRefuse }).request("/upload", { method: "POST", body: "12" });
+
+    expect([res.status, await res.text()]).toEqual([413, "too big"]);
+    expect(seen).toEqual([{ guard: "body-limit", status: 413, reason: "too-large" }]);
+  });
+
+  it("answers through the chain's hook when it has none of its own", async () => {
+    const publish: Middleware = (context, next) => {
+      refuseHookCtx.set(context, () => new Response("chain says no", { status: 413 }));
+      return next();
+    };
+    const res = await makeApp({ maxBytes: 1 }, [publish]).request("/upload", { method: "POST", body: "12" });
+
+    expect(await res.text()).toBe("chain says no");
+  });
+
+  it("lets a bodyless request through untouched", async () => {
+    const app = new Forge();
+    app.use("*", bodyLimit({ maxBytes: 0 }));
+    mapHandler(app, "GET", "/page", () => new Response("ok"));
+
+    expect((await app.request("/page")).status).toBe(200);
+  });
+
+  it("refuses a cap that is not a whole number of bytes when it is built", () => {
+    expect(() => bodyLimit({ maxBytes: 1.5 })).toThrow("bodyLimit: maxBytes must be a whole number of bytes, got 1.5");
+  });
+});
diff --git a/src/security/body-limit.ts b/src/security/body-limit.ts
new file mode 100644
index 00000000..2dc52b05
--- /dev/null
+++ b/src/security/body-limit.ts
@@ -0,0 +1,53 @@
+import type { Middleware } from "@remix-run/fetch-router";
+
+import { createRefusalAnswer } from "./refusal";
+import type { BodyLimitOptions } from "./types";
+
+const TOO_LARGE = { guard: "body-limit", status: 413, reason: "too-large" } as const;
+
+function declaredLength(request: Request): number | null {
+  const header = request.headers.get("content-length");
+  if (header === null) return null;
+  const length = Number(header);
+  return Number.isFinite(length) ? length : null;
+}
+
+async function readCapped(body: ReadableStream<Uint8Array>, maxBytes: number): Promise<Uint8Array<ArrayBuffer> | null> {
+  let seen = 0;
+  let overflowed = false;
+  const counter = new TransformStream<Uint8Array, Uint8Array>({
+    transform(chunk, controller) {
+      seen += chunk.byteLength;
+      if (seen > maxBytes) {
+        overflowed = true;
+        controller.error(new Error("body exceeds the limit"));
+        return;
+      }
+      controller.enqueue(chunk);
+    },
+  });
+  try {
+    return new Uint8Array(await new Response(body.pipeThrough(counter)).arrayBuffer());
+  } catch (thrown) {
+    if (overflowed) return null;
+    throw thrown;
+  }
+}
+
+/** Middleware that refuses `413` a body over `maxBytes`, by its `Content-Length` before reading and by counting the stream when the header is absent or lies. @public */
+export function bodyLimit<Bindings = Record<string, unknown>>(options: BodyLimitOptions<Bindings>): Middleware {
+  const { maxBytes } = options;
+  if (!Number.isInteger(maxBytes) || maxBytes < 0) throw new Error(`bodyLimit: maxBytes must be a whole number of bytes, got ${maxBytes}`);
+  const refuse = createRefusalAnswer<Bindings>(options.onRefuse);
+
+  return async (context, next) => {
+    const { request } = context;
+    const declared = declaredLength(request);
+    if (declared !== null && declared > maxBytes) return refuse(context, TOO_LARGE);
+    if (request.body === null) return next();
+    const bytes = await readCapped(request.body, maxBytes);
+    if (bytes === null) return refuse(context, TOO_LARGE);
+    context.request = new Request(request, { method: request.method, body: bytes });
+    return next();
+  };
+}
