+import { fragmentResponse } from "@y-core/forge/http";
+import { renderPage, renderToString } from "@y-core/forge/render/jsx";
+
+import { defineAction, definePage } from "../app/handlers";
+import { ContactSchema } from "../model/contact";
+import { routes } from "../routes";
+import { ContactThanks, ContactView } from "../views/contact";
+
+export const contactPage = definePage(routes.contact, {
+  loader: (_c, config) => ({ siteName: config.siteName }),
+  view: (_c, _config, state) => renderPage(ContactView({ siteName: state.data.siteName, action: routes.contactSubmit.href() })),
+});
+
+export const contactSubmit = defineAction(routes.contactSubmit, {
+  schema: ContactSchema,
+  handle: async (data, _c, config) => fragmentResponse(await renderToString(ContactThanks({ name: data.name, siteName: config.siteName }))),
+});
