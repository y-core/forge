+export function ContactView({ siteName, action }: { siteName: string; action: string }) {
+  return (
+    <html lang='en'>
+      <head>
+        <meta charset='utf-8' />
+        <title>Contact {siteName}</title>
+      </head>
+      <body>
+        <main>
+          <h1>Contact {siteName}</h1>
+          <form method='post' action={action}>
+            <label>
+              Name <input name='name' required />
+            </label>
+            <label>
+              Email <input name='email' type='email' required />
+            </label>
+            <label>
+              Message <textarea name='message' required />
+            </label>
+            <button type='submit'>Send</button>
+          </form>
+        </main>
+      </body>
+    </html>
+  );
+}
+
+export function ContactThanks({ name, siteName }: { name: string; siteName: string }) {
+  return (
+    <p>
+      Thanks, {name}. {siteName} will be in touch.
+    </p>
+  );
+}
