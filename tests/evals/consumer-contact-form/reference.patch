+++ b/tests/contact.test.ts
@@ -0,0 +1,47 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+
+import { openBunD1 } from "@y-core/forge/testing/d1/bun";
+import type { TestD1 } from "@y-core/forge/testing/d1/bun";
+
+import { createWorker } from "../src/worker";
+import { testEnv } from "./env";
+
+let d1: TestD1;
+
+beforeEach(async () => {
+  d1 = await openBunD1();
+});
+
+afterEach(async () => {
+  await d1.dispose();
+});
+
+function submit(fields: Record<string, string>): Promise<Response> {
+  return createWorker({ scriptSrc: ["'self'"] }).request("/contact", { method: "POST", body: new URLSearchParams(fields) }, testEnv(d1));
+}
+
+const textOf = async (res: Response) => (await res.text()).split(/<[^>]+>/).filter((part) => part.trim() !== "");
+
+describe("the contact form", () => {
+  it("renders a form posting name, email and message back to itself", async () => {
+    const html = await (await createWorker({ scriptSrc: ["'self'"] }).request("/contact", {}, testEnv(d1))).text();
+
+    expect([...html.matchAll(/<(?:input|textarea)[^>]*\sname="([^"]+)"/g)].map((match) => match[1])).toEqual(["name", "email", "message"]);
+    expect(/<form method="post" action="([^"]*)"/.exec(html)?.[1]).toBe("/contact");
+  });
+
+  it("thanks the sender by name, on behalf of the site", async () => {
+    const res = await submit({ name: "Ada", email: "ada@example.com", message: "Hello there, Forge." });
+
+    expect(res.status).toBe(200);
+    expect(await textOf(res)).toEqual(["Thanks, Ada. Forge Eval will be in touch."]);
+  });
+
+  it("refuses a message too short to act on, with 422", async () => {
+    expect((await submit({ name: "Ada", email: "ada@example.com", message: "Hi" })).status).toBe(422);
+  });
+
+  it("refuses a field the form never had", async () => {
+    expect((await submit({ name: "Ada", email: "ada@example.com", message: "Hello there, Forge.", admin: "1" })).status).toBe(422);
+  });
+});
