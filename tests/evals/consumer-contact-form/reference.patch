+import { formMultilineText, formText, v } from "@y-core/forge/validation";
+
+export const ContactSchema = v.strictObject({
+  name: v.pipe(formText(), v.minLength(1), v.maxLength(100)),
+  email: v.pipe(formText(), v.email(), v.maxLength(254)),
+  message: v.pipe(formMultilineText(), v.minLength(10), v.maxLength(2000)),
+});
+
+export type ContactMessage = v.InferOutput<typeof ContactSchema>;
