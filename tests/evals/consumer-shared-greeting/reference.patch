+export function HelloView({ siteName, greeting }: { siteName: string; greeting: string }) {
+  return (
+    <html lang='en'>
+      <head>
+        <meta charset='utf-8' />
+        <title>{siteName}</title>
+      </head>
+      <body>
+        <main>
+          <h1>{greeting}</h1>
+        </main>
+      </body>
+    </html>
+  );
+}
diff --git a/tests/hello.test.ts b/tests/hello.test.ts
new file mode 100644
index 00000000..ca8030c8
--- /dev/null
+++ b/tests/hello.test.ts
@@ -0,0 +1,42 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+
+import { openBunD1 } from "@y-core/forge/testing/d1/bun";
+import type { TestD1 } from "@y-core/forge/testing/d1/bun";
+
+import { greetingFor } from "../src/model/greeting";
+import { createWorker } from "../src/worker";
+import { testEnv } from "./env";
+
+let d1: TestD1;
+
+beforeEach(async () => {
+  d1 = await openBunD1();
+});
+
+afterEach(async () => {
+  await d1.dispose();
+});
+
+describe("the hello page", () => {
+  it("greets the visitor its path names, as the home page greets", async () => {
+    const res = await createWorker({ scriptSrc: ["'self'"] }).request("/hello/Ada", {}, testEnv(d1));
+
+    expect(res.status).toBe(200);
+    expect((await res.text()).split(/<[^>]+>/).filter(Boolean)).toEqual(["Forge Eval", "Welcome to Forge Eval, Ada."]);
+  });
+
+  it("escapes a name that carries markup", async () => {
+    const res = await createWorker({ scriptSrc: ["'self'"] }).request("/hello/%3Cb%3EAda%3C%2Fb%3E", {}, testEnv(d1));
+
+    expect(/<h1>(.*)<\/h1>/.exec(await res.text())?.[1]).toBe("Welcome to Forge Eval, &lt;b&gt;Ada&lt;/b&gt;.");
+  });
+});
+
+describe("greetingFor", () => {
+  it("names the visitor, or calls one with no name a friend", () => {
+    expect([greetingFor("Forge Eval", " Ada "), greetingFor("Forge Eval", "  ")]).toEqual([
+      "Welcome to Forge Eval, Ada.",
+      "Welcome to Forge Eval, friend.",
+    ]);
+  });
+});
