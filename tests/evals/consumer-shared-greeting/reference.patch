+/** How the site greets a visitor: by name, or as a friend when it has none. */
+export function greetingFor(siteName: string, visitor: string): string {
+  const name = visitor.trim();
+  return `Welcome to ${siteName}, ${name === "" ? "friend" : name}.`;
+}
