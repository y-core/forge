{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forge-eval-consumer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2", "new_module_registry"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": { "SITE_NAME": "Forge Eval" },
  "secrets": { "required": [] },
  "d1_databases": [{ "binding": "DB", "database_name": "forge-eval-consumer", "database_id": "local", "migrations_dir": "config/db/migrations" }],
}
