{
  "lsp": {
    "oxlint": { "initialization_options": { "settings": { "run": "onType", "fixKind": "safe_fix", "unusedDisableDirectives": "deny" } } },
    "typescript-ls": { "settings": { "package_version": "7.0.2" } }
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["oxlint", "typescript-ls", "!vtsls", "!typescript-language-server", "!eslint", "..."],
      "formatter": [{ "code_action": "source.fixAll.oxc" }],
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "TSX": {
      "language_servers": ["oxlint", "typescript-ls", "!vtsls", "!typescript-language-server", "!eslint", "..."],
      "formatter": [{ "code_action": "source.fixAll.oxc" }],
      "format_on_save": "on",
      "prettier": { "allowed": false }
    }
  }
}
