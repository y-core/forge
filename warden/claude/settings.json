{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git apply *)",
      "Bash(git -* apply *)",
      "Bash(git clean *)",
      "Bash(git -* clean *)",
      "Bash(git clone *)",
      "Bash(git -* clone *)",
      "Bash(git init *)",
      "Bash(git -* init *)",
      "Bash(git push *)",
      "Bash(git -* push *)",
      "Bash(git --git-dir*)",
      "Bash(git -* --git-dir*)",
      "Bash(git --work-tree*)",
      "Bash(git -* --work-tree*)",
      "Bash(gh *)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler secret *)",
      "Bash(bun x wrangler deploy*)",
      "Bash(bun x wrangler secret *)",
      "Bash(bunx wrangler deploy*)",
      "Bash(bunx wrangler secret *)",
      "Bash(rm -rf *)",
      "Read(**/.dev.vars)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "enabledMcpjsonServers": ["ledger", "warden"],
  "autoMemoryEnabled": false,
  "skillOverrides": {
    "code-review": "user-invocable-only"
  }
}
